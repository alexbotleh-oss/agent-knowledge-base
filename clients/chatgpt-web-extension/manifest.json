{
  "manifest_version": 3,
  "name": "Chat Turn Continuity",
  "version": "0.1.0",
  "description": "Local-only capture and recovery of incomplete ChatGPT web turns.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:8766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Turn Continuity",
    "default_popup": "popup.html"
  }
}
