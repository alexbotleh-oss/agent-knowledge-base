{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexbotleh-oss/agent-knowledge-base/blob/main/schemas/memory_intake_manifest.schema.json",
  "title": "Memory intake batch manifest",
  "description": "Versioned manifest for sanitized structured memory artifacts. IMPORT_READY requests processing; it is not an authorization token.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "batch_id", "created_at", "payload_classification", "source", "artifacts"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "command": { "const": "IMPORT_READY" },
    "batch_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "payload_classification": {
      "type": "string",
      "enum": ["public", "sanitized", "private_reference_only"],
      "description": "Do not commit raw private chat exports. private_reference_only means the batch contains locators/metadata, not private source payloads."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "project_id", "scope_status"],
      "properties": {
        "source_type": { "type": "string", "enum": ["chat_summary", "structured_export", "project_artifact", "mixed", "manual"] },
        "source_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1, "description": "Use unknown when the project cannot be established; do not guess." },
        "conversation_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "source_locator": { "type": "string", "minLength": 1 },
        "captured_at": {
          "description": "Original capture time when known; never replace an unknown source time with review time.",
          "oneOf": [{ "type": "string", "format": "date-time" }, { "const": "unknown" }]
        },
        "scope_status": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] }
      }
    },
    "observed_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages": { "$ref": "#/$defs/contextTags" },
        "tools": { "$ref": "#/$defs/contextTags" },
        "task_types": { "$ref": "#/$defs/contextTags" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "contextTags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "evidence_status", "source_refs"],
        "properties": {
          "value": { "type": "string", "minLength": 1 },
          "evidence_status": { "type": "string", "enum": ["reported", "observed", "inferred", "verified", "unknown"] },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "basis": { "type": "string" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path", "sha256", "lifecycle_status", "evidence_status", "approval_status"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
        "kind": {
          "type": "string",
          "enum": ["raw_source_reference", "source_inventory", "source_records", "memory_records", "event_records", "lesson_records", "decision_records", "task_state", "handoff", "relation_records", "other"]
        },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$", "description": "Relative path from the manifest directory; path traversal and absolute paths are forbidden." },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "record_count": { "type": "integer", "minimum": 0 },
        "lifecycle_status": { "type": "string", "enum": ["candidate", "accepted", "disputed", "superseded", "deprecated", "not_applicable"] },
        "evidence_status": { "type": "string", "enum": ["reported", "observed", "inferred", "verified", "unknown"] },
        "approval_status": { "type": "string", "enum": ["not_requested", "pending", "user_approved", "user_rejected"] },
        "approval_evidence": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
